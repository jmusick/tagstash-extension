{
  "manifest_version": 3,
  "name": "Tagstash",
  "version": "1.15.2",
  "description": "Save the current tab to your Tagstash bookmark manager.",
  "permissions": [
    "storage", "tabs", "activeTab", "scripting", "sidePanel"
  ],
  "host_permissions": [
    "https://tagsta.sh/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Save to Tagstash",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tagstash@orboro.net",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "browsingActivity"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "sidebar_action": {
    "default_title": "Tagstash Sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_panel": "sidebar.html"
  }
}
